DATABASE_URL=postgresql://user:password@host:5432/postgres
# 32 or more random bytes. Required in production. Do not commit the real value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Account API token needs both Stream: Edit and Cloudflare Images: Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Required when seeding reuses a thumbnail path. The seed generates a new picture instead.
FAL_KEY=
# Optional directory for the CLIP model cache. Defaults to the system temp directory.
CLIP_CACHE_DIR=
# How many nearest Shorts are eligible for the next random pick. Defaults to 10.
SHORTS_NEIGHBORS=10
